{
  "name": "@basics/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --sourcemap --external:@livekit/* --external:@prisma/* --external:dotenv --external:pg",
    "dev": "pnpm run build && doppler run -- node dist/main.js dev",
    "start": "pnpm run build && doppler run -- node dist/main.js start",
    "download-files": "pnpm run build && npx livekit-agents download-files",
    "smoke": "doppler run -- tsx scripts/smoke.ts",
    "clear-sessions": "doppler run -- tsx scripts/clear-sessions.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@basics/contracts": "workspace:*",
    "@basics/db": "workspace:*",
    "@livekit/agents": "^1.4.3",
    "@livekit/agents-plugin-livekit": "^1.4.3",
    "@livekit/agents-plugin-silero": "^1.4.3",
    "@livekit/rtc-node": "^0.13.29",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@livekit/protocol": "^1.46.6",
    "@types/node": "^22.19.20",
    "esbuild": "^0.25.0",
    "livekit-server-sdk": "^2.15.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
